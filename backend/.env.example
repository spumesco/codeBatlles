# ================================
# Database (MySQL)
# ================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=codebattles

# SQLAlchemy async connection URL
DATABASE_URL=mysql+aiomysql://root:your_db_password@localhost:3306/codebattles

# Local MySQL does not use SSL.
# Render can set this to /etc/secrets/isrgrootx1.pem
DB_SSL_CA=

# ================================
# Auth (JWT)
# ================================
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ================================
# Judge0
# ================================
JUDGE0_URL=http://localhost:2358
